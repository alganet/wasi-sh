+/* ============ Nested shells
+ *
+ * `sh script`, `sh -c …` and — since build/ash-shebang.patch — any `#!/bin/sh`
+ * file reach ash_main() again inside this same instance, through
+ * run_nofork_applet(). Upstream ash is never asked to do that: it is a
+ * process-per-shell program, and re-entering it used to cost the OUTER shell
+ * everything. `echo a; sh -c 'echo n'; echo b` printed a and n and then
+ * stopped, and an interactive session simply ended.
+ *
+ * Two things had to become true.
+ *
+ * 1. A nested shell's exit has to come back. exitshell() ended in _exit(),
+ *    which is proc_exit here — see the routing there.
+ *
+ * 2. It must not keep the globals it allocates. ash_main() runs every INIT_G()
+ *    unconditionally, replacing the three globals structs, the command hash
+ *    table and the alias table; and this file carries mutable statics besides.
+ *    Everything the outer shell is holding at the moment of the call is saved
+ *    below and put back: localvar_stack and the variable scope it names,
+ *    cmdtable, atab, evalskip and the loop/function nesting the outer shell may
+ *    be inside, the parser's pushback and here-document state, the expander's
+ *    scratch.
+ *
+ * ASH_STATE_LIST IS the shell's whole mutable state, written once so that the
+ * save and the restore cannot drift apart. build/build.sh checks it against
+ * what the COMPILER says this file has — clang names every static `internal
+ * global` in LLVM IR, and read-only data `internal constant` — and fails the
+ * build on a mutable global that is not listed. Reading the source instead was
+ * tried and was worse than useless: a regex over declarations missed every
+ * static with a trailing comment, and could not see a function-local one at
+ * all, while reporting that all was well.
+ *
+ * A function-local static cannot be named here, so this file must not have
+ * one; the guard says so by name when it finds one (they appear in the IR as
+ * `function.variable`). setinteractive()'s two were hoisted for that reason.
+ *
+ * The list is COMPLETE, not minimal, and that is the point. Much of it is
+ * scratch that happens to be dead across this call — parsecmd() re-initialises
+ * the parser's, and the expander's is rebuilt per word — so trimming it to what
+ * demonstrably breaks would pass every test today and quietly stop covering
+ * whatever changes tomorrow. Completeness is the property the guard can check;
+ * minimality is not. Do not trim it.
+ *
+ * What is NOT undone: the nested shell's own allocations. Its globals, hash
+ * table and string stack are abandoned, a few KB per nested shell. That is the
+ * same bargain every applet in this build makes (see README.md's memory note),
+ * and unpicking it would mean teaching ash how to free itself.
+ */
+#if DEBUG
+# define ASH_STATE_DEBUG(F)     F(tracefile)
+#else
+# define ASH_STATE_DEBUG(F)
+#endif
+#if ENABLE_FEATURE_EDITING
+# define ASH_STATE_EDITING(F)   F(line_input_state) F(cmdedit_prompt)
+#else
+# define ASH_STATE_EDITING(F)
+#endif
+#if ENABLE_ASH_ALIAS
+# define ASH_STATE_ALIAS(F)     F(atab)
+#else
+# define ASH_STATE_ALIAS(F)
+#endif
+#if JOBS
+/* shell_tty_info is deliberately absent: it sits inside an `#if 0` upstream.
+ *
+ * ttyfd is a DESCRIPTOR, and putting a number back does not reopen anything —
+ * so this is only sound while a nested shell cannot close it. It cannot here:
+ * setjobctl(0) returns early unless job control is on, and it never is, because
+ * there is no /dev/tty to acquire (every session starts "can't access tty; job
+ * control turned off"). If a tty ever appears, a nested shell's exitshell()
+ * would close the outer's ttyfd and this restore would hand back a closed fd. */
+# define ASH_STATE_JOBS(F) \
+	F(jobctl) F(initialpgrp) F(ttyfd) F(jobtab) F(njobs) F(curjob)
+#else
+# define ASH_STATE_JOBS(F)
+#endif
+#if ENABLE_ASH_MAIL
+# define ASH_STATE_MAIL(F)      F(mailtime_hash)
+#else
+# define ASH_STATE_MAIL(F)
+#endif
+#if !ENABLE_FEATURE_SH_EXTRA_QUIET
+# define ASH_STATE_QUIET(F)     F(did_banner)
+#else
+# define ASH_STATE_QUIET(F)
+#endif
+
+/* The three globals pointers are not in the list below: they are declared
+ * BB_GLOBAL_CONST, so a __typeof__ member of one cannot be assigned to. They
+ * go through busybox's own ASSIGN_CONST_PTR, which is what INIT_G() uses. */
+#define ASH_STATE_LIST(F) \
+	F(argptr) F(optptr) F(optionarg) F(pathopt) \
+	F(doprompt) F(needprompt) \
+	ASH_STATE_DEBUG(F) \
+	ASH_STATE_EDITING(F) \
+	ASH_STATE_ALIAS(F) \
+	ASH_STATE_JOBS(F) \
+	F(cmdnextc) \
+	F(expdest) F(argbackq) F(ifsfirst) F(ifslastp) F(exparg) \
+	F(cmdtable) F(builtinloc) \
+	F(funcblock) F(funcstring_end) \
+	F(evalskip) F(skipcount) F(loopnest) F(funcline) \
+	F(localvar_stack) \
+	F(checkkwd) \
+	ASH_STATE_MAIL(F) \
+	ASH_STATE_QUIET(F) \
+	F(is_interactive) \
+	F(tokpushback) F(lasttoken) F(quoteflag) F(heredoclist) F(wordtext) \
+	F(backquotelist) F(redirnode) F(heredoc)
+
+struct ash_state {
+	struct globals_misc     *misc;
+	struct globals_memstack *memstack;
+	struct globals_var      *var;
+#define ASH_STATE_MEMBER(name) __typeof__(name) name;
+	ASH_STATE_LIST(ASH_STATE_MEMBER)
+#undef ASH_STATE_MEMBER
+};
+
+#define ASH_STATE_SAVE(name)    saved->name = name;
+#define ASH_STATE_RESTORE(name) name = saved->name;
+
+int ash_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+
+/* wasi-sh: run one applet in-process. Everything but this shell goes straight
+ * to run_nofork_applet(); this shell gets its state handed back afterwards.
+ * Guarded like its forward declaration, beside tryexec_applet(). */
+#if ENABLE_FEATURE_SH_STANDALONE
+static int
+ash_run_applet(int applet_no, char **argv)
+{
+	struct ash_state *saved;
+	int status;
+
+	if (applet_main[applet_no] != ash_main)
+		return run_nofork_applet(applet_no, argv);
+
+	if (ash_nest_depth >= ASH_NEST_MAX) {
+		ash_msg("%s: shells nested more than %u deep", argv[0], ASH_NEST_MAX);
+		return 126;
+	}
+
+	/* ckmalloc, not a local: the longjmp that brings a dying nested shell
+	 * back out of run_nofork_applet() unwinds this frame's registers, and a
+	 * struct this size has no business on the stack of a recursive call. */
+	saved = ckmalloc(sizeof(*saved));
+	saved->misc     = ash_ptr_to_globals_misc;
+	saved->memstack = ash_ptr_to_globals_memstack;
+	saved->var      = ash_ptr_to_globals_var;
+	ASH_STATE_LIST(ASH_STATE_SAVE)
+	ash_nest_depth++;
+
+	status = run_nofork_applet(applet_no, argv);
+
+	ash_nest_depth--;
+	ASSIGN_CONST_PTR(&ash_ptr_to_globals_misc,     saved->misc);
+	ASSIGN_CONST_PTR(&ash_ptr_to_globals_memstack, saved->memstack);
+	ASSIGN_CONST_PTR(&ash_ptr_to_globals_var,      saved->var);
+	ASH_STATE_LIST(ASH_STATE_RESTORE)
+	free(saved);
+	return status;
+}
+#endif /* ENABLE_FEATURE_SH_STANDALONE */
+
 /*
