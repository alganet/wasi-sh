+ * takes the session, the filesystem and every warm instance with it. A refusal
+ * is a message. Nonzero also means "this shell is a nested one", which is what
+ * `exec` has to know (see tryexec_applet). */
+#define ASH_NEST_MAX 8
+static unsigned ash_nest_depth;
