+/* wasi-sh host builtins. Both are defined in build/shim/wasistubs.c, which owns
+ * the env.__host_builtin_* wasm-import ABI so this file needs to know nothing
+ * about it.
+ *   host_builtin_lookup(name)     -> 1 if the embedder registered NAME
+ *   host_builtin_run(argv, envp)  -> exit status 0..255, or -1 if the host
+ *                                    could not run it (the JS side traps its
+ *                                    own exceptions and returns -1). */
+extern int host_builtin_lookup(const char *name);
+extern int host_builtin_run(char **argv, char **envp);
