+/* ---- POC: in-process subshell state isolation --------------------------
+ * A real fork gives a subshell a private copy of the shell's memory; the
+ * fork-free path approximates it with ash's own localvar machinery.
+ * subsh_begin(): open a localvar scope, save $- (all shell options) and every
+ * currently-set, non-readonly variable into it, so any WRITE is reverted on
+ * pop while READS still see the inherited value. subsh_end(): unset any
+ * variable CREATED during the eval (found by pointer identity against the
+ * scope), then poplocalvars() restores the rest and the options. $? is left
+ * alone so it propagates out (as $(...) / subshells require). Not yet handled:
+ * traps, cwd (cd is a no-op in this wasm), positional params, function defs. */
+static void
+subsh_begin(void)
+{
+	struct var **vpp, *vp;
+	char **texts;
+	int tn = 0, tcap = 32, i;
+
+	INTOFF;
+	pushlocalvars(1);
+	mklocal((char *)"-", 0);            /* snapshot all shell options ($-) */
+	texts = ckmalloc(tcap * sizeof(texts[0]));
+	for (vpp = vartab; vpp < vartab + VTABSIZE; vpp++) {
+		for (vp = *vpp; vp; vp = vp->next) {
+			if (vp->flags & (VUNSET | VREADONLY))
+				continue;
+			if (tn >= tcap) {
+				tcap *= 2;
+				texts = ckrealloc(texts, tcap * sizeof(texts[0]));
+			}
+			texts[tn++] = ckstrdup(vp->var_text);
+		}
+	}
+	for (i = 0; i < tn; i++) {
+		mklocal(texts[i], 0);           /* setvareq copies it -> free our copy */
+		free(texts[i]);
+	}
+	free(texts);
+	INTON;
+}
+
+static void
+subsh_end(void)
+{
+	struct var **vpp, *vp;
+	struct localvar *lvp;
+	char **leaked;
+	int ln = 0, lcap = 16, i;
+
+	INTOFF;
+	leaked = ckmalloc(lcap * sizeof(leaked[0]));
+	for (vpp = vartab; vpp < vartab + VTABSIZE; vpp++) {
+		for (vp = *vpp; vp; vp = vp->next) {
+			int tracked = 0;
+			if (vp->flags & VUNSET)
+				continue;
+			for (lvp = localvar_stack->lv; lvp; lvp = lvp->next) {
+				if (lvp->vp == vp) { tracked = 1; break; }
+			}
+			if (!tracked) {
+				if (ln >= lcap) {
+					lcap *= 2;
+					leaked = ckrealloc(leaked, lcap * sizeof(leaked[0]));
+				}
+				leaked[ln++] = ckstrdup(vp->var_text);
+			}
+		}
+	}
+	for (i = 0; i < ln; i++) {
+		char *eq = strchr(leaked[i], '=');
+		if (eq) *eq = '\0';
+		unsetvar(leaked[i]);
+		free(leaked[i]);
+	}
+	free(leaked);
+	poplocalvars(0);                    /* restore saved vars + options */
+	INTON;
+}
+
+/* Run evaltree() in-process as a subshell body, CONTAINING exit/errexit/errors
+ * inside it (a real forked child would just _exit). Mirrors redirectsafe()'s
+ * setjmp dance. Returns -1 on normal completion, else the exception_type so the
+ * caller can re-raise SIGINT (EXINT) which must not be swallowed by a subshell.
+ * exitstatus already holds the subshell's status in all cases. */
+static int
+eval_subshell_body(union node *n, int flags)
+{
+	struct jmploc *volatile savehandler = exception_handler;
+	struct jmploc jmploc;
+	volatile int saveint;
+	int e;
+
+	SAVE_INT(saveint);
+	e = setjmp(jmploc.loc);
+	if (!e) {
+		exception_handler = &jmploc;
+		evaltree(n, flags);
+	}
+	exception_handler = savehandler;
+	RESTORE_INT(saveint);
+	/* mirror the top-level EXEXIT handler: `exit N` stashes N in savestatus */
+	if (e == 0)
+		return -1;
+	if (exception_type == EXEXIT && savestatus >= 0)
+		exitstatus = savestatus;
+	return exception_type;
+}
