+/* wasi-sh: the completion engine above, without an editor around it.
+ *
+ * complete_cmd_dir_file() is reachable only from input_tab(), i.e. only while
+ * the guest is drawing its own prompt — and that is one of two ways a terminal
+ * gets built on this shell. The other one edits lines in the PAGE and hands the
+ * guest a finished command, which is what both examples/repl.html and the wide
+ * IDE do; wide has no choice, because its guest is parked on a /dev/hostreq
+ * verb loop and a guest parked at a prompt answers nothing until Enter. This is
+ * how that half reaches the same engine, so the two cannot disagree about what
+ * completes.
+ *
+ * Everything the engine touches lives in S, the statics block INIT_S()
+ * allocates per read_line_input() call — the matches vector included — and
+ * `state` is the file-scope pointer its flags, path_lookup and get_exe_name are
+ * read through. Neither exists outside a live prompt, so this owns a pair of
+ * its own. That is safe rather than reentrant: the caller is a shell builtin,
+ * and a shell that does one thing at a time cannot be editing a line while it
+ * runs one.
+ *
+ * *MATCHES_OUT comes back malloced, holding malloced strings, and is the
+ * CALLER's to free. S's pointer to it is cleared first so DEINIT_S() cannot
+ * free what the caller now owns. */
+unsigned FAST_FUNC complete_word(line_input_t *st, const char *word, int type, char ***matches_out)
+{
+	unsigned n;
+
+	/* No NULL state here, and NOT the &const_int_0 trick read_line_input()
+	 * uses for one. That trick is a four-byte object standing in for a whole
+	 * line_input_t, and it is sound there only because input_tab() returns on
+	 * `flags & TAB_COMPLETION` before anything past `flags` is touched.
+	 * complete_cmd_dir_file() has no such gate: it reads state->path_lookup and
+	 * INDIRECT-CALLS state->get_exe_name, both well past the four bytes. So a
+	 * caller that has no state has no completions, said plainly. */
+	if (!st) {
+		*matches_out = NULL;
+		return 0;
+	}
+
+	INIT_S();
+	state = st;
+	complete_cmd_dir_file(word, type);
+	/* input_tab() does this before it shows or inserts anything, and a name
+	 * really can arrive twice — `echo` is an applet AND a shell builtin. */
+	sort_and_dedup_matches();
+	n = num_matches;
+	*matches_out = matches;
+	matches = NULL;
+	num_matches = 0;
+	DEINIT_S();
+	return n;
+}
+
 #endif  /* FEATURE_TAB_COMPLETION */
 
 
--- a/include/libbb.h
+++ b/include/libbb.h
@@ -2177,6 +2177,26 @@
  */
 int read_line_input(line_input_t *st, const char *prompt, char *command, int maxsize) FAST_FUNC;
 void show_history(const line_input_t *st) FAST_FUNC;
+# if ENABLE_FEATURE_TAB_COMPLETION
+/* wasi-sh: complete WORD exactly as Tab would, with no editor and no terminal,
+ * for a host that edits its lines somewhere else. Returns the match count and
+ * stores a malloced vector of malloced strings in *MATCHES_OUT, which the
+ * caller frees.
+ *
+ * Candidates are BASENAMES, not paths — completing "src/te" answers
+ * "terminal.mjs" — and a directory carries a trailing slash while a file does
+ * not. Both are the editor's own behaviour, kept rather than corrected so that
+ * a page's Tab and the guest's Tab agree.
+ *
+ * ST must not be NULL: unlike read_line_input(), this reaches fields past
+ * `flags`. A NULL one answers zero matches rather than pretending. */
+unsigned complete_word(line_input_t *st, const char *word, int type, char ***matches_out) FAST_FUNC;
+/* lineedit.c's FIND_* enum is private to it; these are the same three values
+ * under names a caller may say. */
+#  define COMPLETE_EXE  0
+#  define COMPLETE_DIR  1
+#  define COMPLETE_FILE 2
+# endif
 # if ENABLE_FEATURE_EDITING_SAVE_ON_EXIT
 void save_history(line_input_t *st) FAST_FUNC;
 # endif
