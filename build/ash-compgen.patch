+#if ENABLE_FEATURE_TAB_COMPLETION
+/* wasi-sh: `compgen -c|-f|-d WORD` — busybox's own tab completion, as a
+ * command, for a terminal that owns its line editing.
+ *
+ * The shell has two kinds of consumer and only ever had completion for one of
+ * them. A terminal that gives the guest a tty gets libbb/lineedit.c's Tab for
+ * free. A terminal that edits lines in the host — examples/repl.html, and the
+ * wide IDE, which cannot do otherwise because its guest is parked on a
+ * /dev/hostreq loop serving an iframe — had nothing to ask. This is the ask,
+ * and it runs the SAME complete_cmd_dir_file() the editor runs, so a page's Tab
+ * and a prompt's Tab cannot drift apart.
+ *
+ * Command position is the interesting mode: FIND_EXE_ONLY is what pulls in the
+ * applet table, this shell's builtins, its functions, its aliases and, through
+ * ash_command_name() below, the embedder's host builtins — none of which a host
+ * can enumerate from outside.
+ *
+ * Output is one candidate per line, and unambiguous because add_match() drops
+ * any candidate containing a control character (its ESC-injection guard), so a
+ * newline can never appear inside one. Status 1 for no matches, as bash's
+ * compgen reports. */
+static int FAST_FUNC
+compgencmd(int argc UNUSED_PARAM, char **argv)
+{
+	char **matches = NULL;
+	const char *word;
+	unsigned n, i;
+	int type = -1;
+	int c;
+
+	/* Looped rather than switched once, so that nextopt() gets to eat a "--"
+	 * — which is the only way to complete a WORD that starts with a dash.
+	 * `ls -l<TAB>` asks for exactly that, and without the loop the "--" itself
+	 * became the word. Last flag wins if several are given. */
+	while ((c = nextopt("cfd")) != '\0') {
+		switch (c) {
+		case 'c': type = COMPLETE_EXE; break;
+		case 'd': type = COMPLETE_DIR; break;
+		case 'f': type = COMPLETE_FILE; break;
+		}
+	}
+	if (type < 0)
+		ash_msg_and_raise_error("usage: compgen -c|-f|-d [--] [WORD]");
+
+	/* No WORD is the empty prefix, which means "everything of that kind" —
+	 * the same thing Tab on an empty word does. */
+	word = *argptr ? *argptr : "";
+
+	/* path_lookup is read for FIND_EXE_ONLY and must be THIS shell's PATH, not
+	 * the one a prompt happened to be started with: a `cd` and a PATH
+	 * assignment both land between two completions, so it is refreshed on
+	 * every call rather than at setup.
+	 *
+	 * line_input_state exists only for an INTERACTIVE shell, and the consumers
+	 * this builtin is for — `sh -c 'compgen …'`, and every session that edits
+	 * its lines in the host — are never interactive. So the second branch
+	 * builds a state of its own rather than passing NULL: complete_word() has
+	 * no completions to offer without one, and get_exe_name is what makes the
+	 * difference between seeing this shell's functions, aliases and host
+	 * builtins and seeing only the applet table. */
+	if (line_input_state) {
+		line_input_state->path_lookup = pathval();
+		n = complete_word(line_input_state, word, type, &matches);
+	} else {
+		line_input_t *st = new_line_input_t(FOR_SHELL | WITH_PATH_LOOKUP);
+		st->path_lookup = pathval();
+		st->get_exe_name = ash_command_name;
+		n = complete_word(st, word, type, &matches);
+		free_line_input_t(st);
+	}
+
+	for (i = 0; i < n; i++) {
+		out1fmt("%s\n", matches[i]);
+		free(matches[i]);
+	}
+	free(matches);
+	return n ? 0 : 1;
+}
+#endif
+
 /* Keep these in proper order since it is searched via bsearch() */
 static const struct builtincmd builtintab[] = {
 	{ BUILTIN_SPEC_REG      "."       +1, dotcmd     },
@@ -11311,12 +11398,21 @@
