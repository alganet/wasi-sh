+	 * terminal that edits its lines in the host instead of here. See
+	 * compgencmd() below. Kept in the table's ASCII order, between command
+	 * and continue, because find_builtin() bsearch()es it — and counted in
+	 * ENVCMD's sum below, because the three CMD offsets are hand-tallied. */
+#if ENABLE_FEATURE_TAB_COMPLETION
+	{ BUILTIN_REGULAR       "compgen" +1, compgencmd },
+#endif
 	{ BUILTIN_SPEC_REG      "continue"+1, breakcmd   },
 #if ENABLE_ASH_ECHO
 	{ BUILTIN_REGULAR       "echo"    +1, echocmd    },
 #endif
 #define ENVCMD (COMMANDCMD + \
 				/* command */	1 * ENABLE_ASH_CMDCMD + \
+				/* compgen */	1 * ENABLE_FEATURE_TAB_COMPLETION + \
 				/* continue */	1 + \
 				/* echo */	1 * ENABLE_ASH_ECHO + \
 				0)
@@ -11430,6 +11526,24 @@
 	}
 #endif
 
+	/* wasi-sh: host builtins are the fourth kind of name find_command() can
+	 * resolve here, and the only kind a host cannot enumerate for itself —
+	 * the registry lives in JS, behind a lookup(name) that answers one
+	 * question at a time. Without this arm, `php` is a command the shell runs
+	 * and completion has never heard of.
+	 *
+	 * Optional at the far end: the contract's names() is opt-in, because an
+	 * embedder may register a lazy namespace with nothing to list. Then this
+	 * returns NULL at index 0 and the list simply ends, which is also what a
+	 * build with no builtins at all does. */
+	for (n = 0;; n++) {
+		const char *hb = host_builtin_name(n);
+		if (!hb)
+			break;
+		if (--i < 0)
+			return hb;
+	}
+
 	return NULL;
 }
 #endif
