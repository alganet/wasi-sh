+/* wasi-sh: hoisted out of input_tab(), which is where these ten lines used to
+ * live inline. complete_word() below needs them too — `echo` is both an applet
+ * and a shell builtin, so a bare `compgen -c ec` answered "echo" twice — and a
+ * completion list that differs between the guest's own Tab and a host's is the
+ * one thing this file is now careful not to allow. Same code, one caller more.
+ */
+static void sort_and_dedup_matches(void)
+{
+	unsigned i, n = 0;
+
+	if (!matches)     /* the loop below underflows on an empty vector */
+		return;
+	qsort_string_vector(matches, num_matches);
+	for (i = 0; i < num_matches - 1; ++i) {
+		if (strcmp(matches[i], matches[i + 1]) == 0) {
+			free(matches[i]);
+		} else {
+			matches[n++] = matches[i];
+		}
+	}
+	matches[n++] = matches[i];
+	num_matches = n;
+}
